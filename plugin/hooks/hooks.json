{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/launcher.mjs",
              "--if-continuum",
              "npx",
              "-y",
              "getcontinuum@0.6.0",
              "ingest"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/launcher.mjs",
              "--if-continuum",
              "npx",
              "-y",
              "getcontinuum@0.6.0",
              "ingest"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/launcher.mjs",
              "--if-continuum",
              "npx",
              "-y",
              "getcontinuum@0.6.0",
              "ingest"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__continuum__start_task|mcp__continuum__update_task",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 30,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/launcher.mjs",
              "--if-continuum",
              "npx",
              "-y",
              "getcontinuum@0.6.0",
              "ingest"
            ]
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 30,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/launcher.mjs",
              "--if-continuum",
              "npx",
              "-y",
              "getcontinuum@0.6.0",
              "ingest"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 30,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/launcher.mjs",
              "--if-continuum",
              "npx",
              "-y",
              "getcontinuum@0.6.0",
              "ingest"
            ]
          }
        ]
      }
    ]
  }
}
